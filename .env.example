# Copy this file to ".env" and fill it in.
# For local testing you can leave everything blank -- the bot still runs.

# From Azure Portal -> your Azure Bot -> Configuration -> Microsoft App ID
MICROSOFT_APP_ID=

# From Azure Portal -> App registration -> Certificates & secrets -> client secret VALUE
MICROSOFT_APP_PASSWORD=

# MultiTenant (default) | SingleTenant | UserAssignedMSI
MICROSOFT_APP_TYPE=MultiTenant

# Only needed if APP_TYPE is SingleTenant
MICROSOFT_APP_TENANT_ID=

# --- Stage 3: the agent ---
# Get one at https://huggingface.co/settings/tokens
# Leave blank and the bot stays an echo bot.
HF_TOKEN=

# Port the local server listens on
PORT=3978

# --- Telegram (optional) ---
# From @BotFather on Telegram: send /newbot and copy the token.
TELEGRAM_BOT_TOKEN=
# Any random string. Telegram sends it back so we know the call is genuine.
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp, via the Meta Cloud API (optional) ---
# developers.facebook.com -> your app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you invent. Paste the same one into the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=
# Optional but recommended, from Meta app settings -> Basic -> App secret
WHATSAPP_APP_SECRET=

# --- Google Chat (optional) ---
# The endpoint URL exactly as entered in Google Cloud -> Chat API -> Configuration.
GOOGLE_CHAT_AUDIENCE=
# Optional. Your Google Cloud project number -- limits add-on requests to it.
GOOGLE_CHAT_PROJECT_NUMBER=
# Service account key, as raw JSON or base64. Lets slow replies arrive after
# Google's 30 second window. Without it they get a "still thinking" note.
GOOGLE_CHAT_SERVICE_ACCOUNT_JSON=

# --- Organizations bringing their own AI (optional) ---
# Turns on /admin and /settings. Make one with:  python orgs.py new-secret-key
# Keep it safe: it unlocks every saved client key. Changing it makes saved
# keys unreadable, so clients would have to enter them again.
ORG_SECRETS_KEY=
# Password for the Inanovai team's /admin page.
ADMIN_PASSWORD=
# Where orgs.json is kept. Blank = ./data locally, /home/data on Azure.
DATA_DIR=
# Local testing only: let a client address point at this machine (Ollama).
ALLOW_PRIVATE_AI_URLS=

# The public https address this bot runs at, no trailing slash.
# Used when registering the Telegram webhook.
PUBLIC_URL=https://inanovai-teams-bot.azurewebsites.net
