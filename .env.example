# Copy this file to ".env" and fill it in.
# For local testing you can leave everything blank -- the bot still runs.

# From Azure Portal -> your Azure Bot -> Configuration -> Microsoft App ID
MICROSOFT_APP_ID=

# From Azure Portal -> App registration -> Certificates & secrets -> client secret VALUE
MICROSOFT_APP_PASSWORD=

# MultiTenant (default) | SingleTenant | UserAssignedMSI
MICROSOFT_APP_TYPE=MultiTenant

# Only needed if APP_TYPE is SingleTenant
MICROSOFT_APP_TENANT_ID=

# --- Stage 3: the agent ---
# Get one at https://huggingface.co/settings/tokens
# Leave blank and the bot stays an echo bot.
HF_TOKEN=

# Port the local server listens on
PORT=3978

# --- Telegram (optional) ---
# From @BotFather on Telegram: send /newbot and copy the token.
TELEGRAM_BOT_TOKEN=
# Any random string. Telegram sends it back so we know the call is genuine.
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp, via the Meta Cloud API (optional) ---
# developers.facebook.com -> your app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you invent. Paste the same one into the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=
# Optional but recommended, from Meta app settings -> Basic -> App secret
WHATSAPP_APP_SECRET=

# The public https address this bot runs at, no trailing slash.
# Used when registering the Telegram webhook.
PUBLIC_URL=https://inanovai-teams-bot.azurewebsites.net
